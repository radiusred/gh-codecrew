#!/usr/bin/env bash
# Regenerate internal/cli/contract_history.go: the SHA-256 of every role
# contract as each tagged release shipped it, so `gh codecrew roles sync`
# can tell a local contract that is still some release's text (safe to
# replace) from a fork (never touched) — SPEC §7, M18-R6. Run it from
# anywhere in a clone with the release tags fetched, after tagging a
# release; TestContractHistoryCoversEveryTag fails until it has been run,
# and the release workflow runs that test before building.
set -euo pipefail

root=$(git rev-parse --show-toplevel)
out="$root/internal/cli/contract_history.go"
roles=(implementer reviewer qa doc-synthesizer coordinator)

{
  echo '// Code generated by scripts/contract-history; DO NOT EDIT.'
  echo
  echo 'package cli'
  echo
  echo '// contractHistory is every role contract text a tagged release shipped,'
  echo '// by SHA-256, in release order: before 2.0 under roles/, from 2.0 under'
  echo '// .codecrew/roles/. roles sync reads it to recognise a release text.'
  echo 'var contractHistory = []releasedContract{'
  for tag in $(git -C "$root" tag -l 'v[0-9]*' | sort -V); do
    for role in "${roles[@]}"; do
      for path in ".codecrew/roles/$role.md" "roles/$role.md"; do
        if git -C "$root" cat-file -e "$tag:$path" 2>/dev/null; then
          sum=$(git -C "$root" show "$tag:$path" | sha256sum | cut -d' ' -f1)
          printf '\t{Release: "%s", Role: "%s", SHA256: "%s"},\n' "$tag" "$role" "$sum"
          break
        fi
      done
    done
  done
  echo '}'
} > "$out"
gofmt -w "$out"
echo "wrote $out"
