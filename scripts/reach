#!/usr/bin/env bash
# reach — read the hub's and its spokes' reach figures from GitHub and print
# them as the Markdown snapshot a milestone records at its open and its close
# (M23-R1, #424): stars, forks, watchers, 14-day views, clones and
# referrers per repository; the hub's release-asset downloads by platform;
# and the distinct authors of issues, PRs and discussions, crew apart from
# everyone else. Reading the same way twice is the point, so the closing
# snapshot is this command again. It only reads; it never writes to GitHub.
set -euo pipefail

usage() {
  cat <<'EOF'
usage: scripts/reach [--hub OWNER/REPO] [--operator LOGIN] [--label TEXT]
                     [--json] [SPOKE...]
       scripts/reach [--label TEXT] --from FILE

Prints the reach snapshot for the hub (default radiusred/gh-codecrew) and
each SPOKE named (default radiusred/codecrew-www) as Markdown, ready to post
as a comment on the milestone issue.

The traffic endpoints (views, clones, referrers) need push access, so run it
under your own gh auth, the operator's, with no seat GH_TOKEN exported.
It only reads; it never writes to GitHub.

The crew is the hub's .codecrew/config.yml app: identities (as <slug>[bot])
plus the operator, whose login comes from `gh api user` unless --operator
names it. Everyone else is listed by name.

  --hub OWNER/REPO   the hub to read (default radiusred/gh-codecrew)
  --operator LOGIN   the operator's login, counted as crew
  --label TEXT       how the snapshot opens, e.g. "M23-R1 closing snapshot"
                     (default "Reach snapshot")
  --json             print the figures read as JSON instead of Markdown
  --from FILE        render a JSON file saved with --json; reads nothing
                     from GitHub

Search Console is not read, and which downloads were the crew's own
installs is not knowable from GitHub: only the operator can say, so the
snapshot carries an _(operator: ...)_ placeholder for each, to fill in by
hand before posting.
EOF
}

die() { echo "reach: $*" >&2; exit 1; }

# render turns the JSON that gather prints into the Markdown snapshot, in
# the shape of M23's opening snapshot (comment 6384122881 on #423): the
# table, then four bullets, with an _(operator: ...)_ placeholder for each
# figure only the operator has. Everything else the script reads (every
# release, each spoke's authors) follows in a collapsed appendix. $1 is the
# label the snapshot opens with.
render() {
  # read, not $(cat ...): --from needs nothing but bash and jq.
  local prog
  IFS= read -r -d '' prog <<'JQ' || true
def iscrew($apps; $op):
  . as $l
  | ($l == $op) or (($l | endswith("[bot]")) and any($apps[]; . + "[bot]" == $l));
# "a", "a and b", "a, b and c"
def listed: if length <= 1 then join("") else (.[:-1] | join(", ")) + " and " + .[-1] end;
# The operator first, then by count, highest first.
def counted($op):
  sort_by((if .login == $op then 0 else 1 end), -.count, .login)
  | map("\(.login) (\(.count))") | listed;
def word: . as $n | ["no", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine"][$n] // ($n | tostring);
def authors($apps; $op):
  (map(select(.login | iscrew($apps; $op)))) as $crew
  | (map(select(.login | iscrew($apps; $op) | not))) as $others
  | (if ($others | length) == 0 then "none."
     else "**\($others | length)**: \($others | counted($op))." end)
    + (if ($crew | length) == 0 then ""
       elif ($others | length) == 0 then " The authors are \($crew | counted($op))."
       else " The crew authors are \($crew | counted($op))." end);
def discussions($apps; $op):
  if .discussions_enabled | not then "Discussions are not enabled."
  elif (.discussion_authors | length) == 0 then "Discussions are enabled, and none has been opened yet."
  else "Non-crew authors of discussions: \(.discussion_authors | authors($apps; $op))" end;
def refs:
  if length == 0 then "none"
  else map("\(.referrer) \(.count) (\(.uniques))") | join(", ") end;
def platform: sub("\\.exe$"; "") | split("_") | last;
def plats: .assets | map({p: (.name | platform), n: .downloads}) | sort_by(.p);
def total: [plats[].n] | add // 0;
# "v2.1.1 has darwin-arm64 1, linux-amd64 2, and 0 on the other three
# platforms"; $zeros false leaves the last clause out.
def has($zeros):
  plats as $a
  | [$a[] | select(.n > 0) | "\(.p) \(.n)"] as $some
  | ([$a[] | select(.n == 0)] | length) as $z
  | if ($a | length) == 0 then "\(.tag) has no assets"
    elif ($some | length) == 0 then "\(.tag) has 0 on "
      + ({"1": "its one platform", "2": "both platforms"}[$a | length | tostring]
         // "all \($a | length | word) platforms")
    else "\(.tag) has \($some | join(", "))"
      + (if $zeros and $z > 0
         then ", and 0 on the other " + (if $z == 1 then "platform" else "\($z | word) platforms" end)
         else "" end)
    end;
def releases:
  .releases as $r
  | if ($r | length) == 0 then "no releases yet."
    else
      ($r[0] | total) as $t
      | "\($r[0] | has(true))."
      + (if $t == 0 then " Nothing has been downloaded, so there were **0 outside installs**."
         else " The operator confirms that _(operator: how many of these \($t))_ were the crew's own machines, so there were **_(operator: \($t) less those)_ outside installs**." end)
      + (if ($r | length) > 1 then " \($r[1] | has(false))." else "" end)
      + ([$r[2:][] | select((plats | length) > 1 and all(plats[]; .n > 0)) | .tag] as $even
         | if ($even | length) == 0 then ""
           else " Earlier releases show some downloads spread evenly across all \($r[0] | plats | length | word) platforms (\($even | join(", "))). That pattern looks like automated fetches rather than people, and is noted only so that the closing snapshot reads them the same way." end)
    end;
. as $s
| $s.crew_apps as $apps | $s.operator as $op
| ($s.repos | map(select(.name == $s.hub)) | .[0]) as $hub
| "**\($label) (GitHub side), \($s.taken)**, read by `scripts/reach`.",
  "",
  "| Measure | \([$s.repos[].name] | join(" | ")) |",
  "|---|\([$s.repos[] | "---"] | join("|"))|",
  "| Stars / forks / watchers | \([$s.repos[] | "\(.stars) / \(.forks) / \(.watchers)"] | join(" | ")) |",
  "| Views, 14 days (unique) | \([$s.repos[] | "\(.views.count) (\(.views.uniques))"] | join(" | ")) |",
  "| Clones, 14 days (unique) | \([$s.repos[] | "\(.clones.count) (\(.clones.uniques))"] | join(" | ")) |",
  "| Referrers | \([$s.repos[] | .referrers | refs] | join(" | ")) |",
  "",
  "- **Non-crew authors of issues and PRs, all time:** \($hub.authors | authors($apps; $op)) \($hub | discussions($apps; $op))",
  "- **Release downloads:** \($hub | releases)",
  "- **Clones** are dominated by the crew's own dispatch clones and CI, and are not a measure of outside use.",
  "- **Search Console (operator's report, _(operator: date)_):** _(operator: how many URLs are indexed and how many are not, and why each one is not)_. Impressions and clicks for the previous 28 days: _(operator)_.",
  "",
  "<details><summary>Everything else scripts/reach read: every release, and each spoke's authors</summary>",
  "",
  "- **Release downloads, every release** (raw counts, not unique: `gh extension install` and `upgrade` each fetch one asset):",
  ($hub.releases[] | "  - \(has(true)).") ,
  ($s.repos[] | select(.name != $s.hub)
   | "- **\(.name), non-crew authors of issues and PRs, all time:** \(.authors | authors($apps; $op)) \(discussions($apps; $op))"),
  "",
  "</details>"
JQ
  jq -r --arg label "$1" "$prog"
}

# counts turns one login per line into [{login, count}], sorted by login.
counts() {
  jq -Rn '[inputs | select(. != "")] | group_by(.) | map({login: .[0], count: length})'
}

traffic() {
  gh api "repos/$1/traffic/$2" ${3:+--jq "$3"} ||
    die "cannot read $2 traffic for $1: it needs push access, so run under your own gh auth (unset GH_TOKEN)"
}

# repo prints one repository's figures as a JSON object; $2 is "hub" for the
# hub, whose releases are read too.
repo() {
  local name=$1 role=$2 owner=${1%%/*} short=${1#*/}
  local meta views clones refs authors dauthors='[]' releases=null
  meta=$(gh api "repos/$name" --jq '{stars: .stargazers_count, forks: .forks_count, watchers: .subscribers_count, discussions_enabled: .has_discussions}')
  views=$(traffic "$name" views '{count, uniques}')
  clones=$(traffic "$name" clones '{count, uniques}')
  refs=$(traffic "$name" popular/referrers '[.[] | {referrer, count, uniques}]')
  authors=$(gh api --paginate "repos/$name/issues?state=all&per_page=100" --jq '.[] | .user.login // "ghost"' | counts)
  if [ "$(jq -r .discussions_enabled <<<"$meta")" = true ]; then
    # GraphQL names an App's bot user without the [bot] REST gives it.
    # shellcheck disable=SC2016 # $owner, $name, $endCursor are GraphQL's.
    dauthors=$(gh api graphql --paginate -F owner="$owner" -F name="$short" -f query='
      query($owner: String!, $name: String!, $endCursor: String) {
        repository(owner: $owner, name: $name) {
          discussions(first: 100, after: $endCursor) {
            pageInfo { hasNextPage endCursor }
            nodes { author { __typename login } }
          }
        }
      }' --jq '.data.repository.discussions.nodes[]
        | if .author == null then "ghost"
          elif .author.__typename == "Bot" then .author.login + "[bot]"
          else .author.login end' | counts)
  fi
  if [ "$role" = hub ]; then
    releases=$(gh api --paginate "repos/$name/releases?per_page=100" \
      --jq '.[] | select(.draft | not) | {tag: .tag_name, assets: [.assets[] | {name, downloads: .download_count}]}' | jq -s .)
  fi
  jq -n --arg name "$name" --argjson meta "$meta" --argjson views "$views" \
    --argjson clones "$clones" --argjson refs "$refs" --argjson authors "$authors" \
    --argjson dauthors "$dauthors" --argjson releases "$releases" \
    '{name: $name} + $meta + {views: $views, clones: $clones, referrers: $refs,
      authors: $authors, discussion_authors: $dauthors, releases: $releases}'
}

# gather reads every figure from GitHub and prints them as one JSON object.
gather() {
  local hub=$1 operator=$2; shift 2
  local apps taken spoke
  [ -n "$operator" ] || operator=$(gh api user --jq .login) ||
    die "cannot read your login from gh api user; name the operator with --operator"
  apps=$(gh api -H 'Accept: application/vnd.github.raw' "repos/$hub/contents/.codecrew/config.yml" |
    sed -n 's/^[[:space:]]*identity:[[:space:]]*app:\([A-Za-z0-9-]*\).*/\1/p' |
    jq -Rn '[inputs | select(. != "")] | unique') ||
    die "cannot read $hub/.codecrew/config.yml for the crew's App identities"
  taken=$(date -u '+%Y-%m-%d %H:%MZ')
  {
    repo "$hub" hub
    for spoke in "$@"; do repo "$spoke" spoke; done
  } | jq -s --arg taken "$taken" --arg hub "$hub" --arg op "$operator" --argjson apps "$apps" \
    '{taken: $taken, hub: $hub, operator: $op, crew_apps: $apps, repos: .}'
}

main() {
  local hub=radiusred/gh-codecrew operator="" json=false from="" label="Reach snapshot"
  local spokes=()
  while [ $# -gt 0 ]; do
    case $1 in
      --hub) hub=${2:?--hub needs OWNER/REPO}; shift 2 ;;
      --operator) operator=${2:?--operator needs a login}; shift 2 ;;
      --json) json=true; shift ;;
      --label) label=${2:?--label needs text}; shift 2 ;;
      --from) from=${2:?--from needs a file}; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      -*) usage >&2; exit 2 ;;
      *) spokes+=("$1"); shift ;;
    esac
  done
  command -v jq >/dev/null || die "needs jq"
  if [ -n "$from" ]; then
    render "$label" <"$from"
    return
  fi
  [ ${#spokes[@]} -gt 0 ] || spokes=(radiusred/codecrew-www)
  # Read everything before printing anything, so a failed read prints no
  # half a snapshot.
  # snap is global: the EXIT trap reads it after main has returned.
  snap=$(mktemp)
  trap 'rm -f -- "$snap"' EXIT
  gather "$hub" "$operator" "${spokes[@]}" >"$snap"
  if [ "$json" = true ]; then
    cat "$snap"
  else
    render "$label" <"$snap"
  fi
}

main "$@"
