#!/usr/bin/env bash
# codecrew-token <app-slug> — mint a GitHub App installation token for a role identity.
#
# Since 1.1 this is `gh codecrew identity token`, which reads the same key and
# credential stub under ~/.config/codecrew/ (and, before them, the env vars a
# platform binds) and discovers the installation from the App itself. This
# file stays so the URL the 1.0 contracts installed keeps resolving.
exec gh codecrew identity token "$@"
